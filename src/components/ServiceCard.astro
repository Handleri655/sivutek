---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  index: number;
  title: string;
  summary: string;
  slug: string;
  points?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, index, title, summary, slug, points = [], image, imageAlt = "" } = Astro.props;
const label = String(index).padStart(2, "0");
---

<a href={href} class="lift group flex h-full flex-col overflow-hidden border border-line bg-card hover:border-accent">
  {
    image ? (
      <span class="block aspect-[4/3] overflow-hidden bg-paper-deep">
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          class="h-full w-full object-cover"
        />
      </span>
    ) : (
      <span class="flex items-center justify-between gap-4 p-6 pb-0">
        <span class="font-serif text-3xl text-accent">{label}</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-8 w-8 text-ink" aria-hidden="true">
          {slug === "ilmalampopumput" && (
            <g fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="8" width="10" height="14" />
              <rect x="18" y="6" width="10" height="8" />
              <path d="M14 12h4" />
            </g>
          )}
          {slug === "rannien-puhdistus" && (
            <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M6 12h20" />
              <path d="M8 12c2 6 4 6 6 0" />
              <path d="M22 12v10" />
            </g>
          )}
        </svg>
      </span>
    )
  }
  <span class="flex flex-1 flex-col p-6">
    <h3 class="text-2xl group-hover:underline">{title}</h3>
    <p class="mt-3 text-ink-soft">{summary}</p>
    {
      points.length > 0 && (
        <ul class="mt-4 grid list-disc gap-1 pl-5 text-ink-soft">
          {points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )
    }
    <span class="mt-6 font-semibold text-accent">Lue lisää</span>
  </span>
</a>
