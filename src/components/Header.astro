---
import { company, visibleNavigation } from "../data/company";
import { getReferenssit } from "../lib/content";
import Logo from "./Logo.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const navigation = visibleNavigation((await getReferenssit()).length > 0);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class:list={["site-header", overlay && "is-overlay"]}>
  <div class="wrap flex h-full items-center justify-between gap-4">
    <a href="/" aria-label="Sivutek, etusivu" class:list={["site-logo", overlay ? "text-white" : "text-ink"]}>
      <Logo onDark={overlay} />
    </a>

    <nav class="site-nav" aria-label="Päävalikko">
      <div class="nav-track">
        {
          navigation.map((item) => (
            <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </div>
      <a class="nav-call" href={`tel:${company.phoneTel}`} aria-label={`Soita ${company.phoneDisplay}`}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M7.2 3.8c.4-.4 1-.5 1.5-.3l2.2.9c.5.2.8.7.8 1.2l-.3 2.2c0 .4-.3.8-.6 1L9.4 10c.9 1.8 2.4 3.3 4.2 4.2l1.2-1.4c.2-.3.6-.6 1-.6l2.2-.3c.5 0 1 .3 1.2.8l.9 2.2c.2.5.1 1.1-.3 1.5l-1.3 1.3c-.4.4-1 .6-1.6.5C11.6 17.4 6.2 12 5.4 6.7c-.1-.6.1-1.2.5-1.6z"
          ></path>
        </svg>
        <span class="xl:hidden">Soita</span>
        <span class="hidden xl:inline">Soita {company.phoneDisplay}</span>
      </a>
    </nav>

    <details class="nav-menu">
      <summary class="nav-toggle">
        <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        Valikko
      </summary>
      <nav class="nav-panel" aria-label="Mobiilivalikko">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="nav-panel-call" href={`tel:${company.phoneTel}`}>Soita {company.phoneDisplay}</a>
          </li>
          <li>
            <a href={company.smsHref}>Lähetä tekstiviesti</a>
          </li>
          <li>
            <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
