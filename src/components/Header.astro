---
import { company, visibleNavigation } from "../data/company";
import { getReferenssit } from "../lib/content";
import Logo from "./Logo.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const navigation = visibleNavigation((await getReferenssit()).length > 0);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class:list={[
    "sticky top-0 z-50 h-16 border-b backdrop-blur",
    overlay ? "border-white/15 bg-ink/80 text-white" : "border-line bg-paper/95",
  ]}
>
  <div class="wrap flex h-full items-center justify-between gap-4">
    <a href="/" aria-label="Sivutek, etusivu" class:list={[overlay ? "text-white" : "text-ink"]}>
      <Logo onDark={overlay} />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Päävalikko">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "font-medium",
              overlay ? "text-white hover:text-sand" : "hover:text-accent",
              isActive(item.href) &&
                (overlay
                  ? "text-sand underline decoration-2 underline-offset-8"
                  : "text-accent underline decoration-2 underline-offset-8"),
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary" href={`tel:${company.phoneTel}`} aria-label={`Soita ${company.phoneDisplay}`}>
        <span class="xl:hidden">Soita</span>
        <span class="hidden xl:inline">Soita {company.phoneDisplay}</span>
      </a>
    </nav>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer rounded-sm px-3 py-2 font-semibold">Valikko</summary>
      <nav
        class="absolute right-0 z-50 mt-2 w-64 border border-line bg-card p-2 text-ink shadow-lg"
        aria-label="Mobiilivalikko"
      >
        <ul class="m-0 grid list-none p-0">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block px-3 py-3 font-medium hover:bg-paper"
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="block px-3 py-3 font-semibold text-accent" href={`tel:${company.phoneTel}`}>
              Soita {company.phoneDisplay}
            </a>
          </li>
          <li>
            <a class="block px-3 py-3 font-medium" href={company.smsHref}>Lähetä tekstiviesti</a>
          </li>
          <li>
            <a class="block px-3 py-3 font-medium" href={company.whatsappHref} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
