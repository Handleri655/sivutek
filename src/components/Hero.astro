---
import { getImage } from "astro:assets";
import heroPhoto from "../assets/hero.jpg";
import { company } from "../data/company";
import { googleReviews } from "../data/reviews";

const hero = await getImage({
  src: heroPhoto,
  widths: [640, 1024, 1600, 2200],
  format: "webp",
  quality: 72,
});
---

<section class="hero-screen on-dark relative isolate flex items-end text-white" aria-label="Sivutek">
  <img
    src={hero.src}
    srcset={hero.srcSet.attribute}
    sizes="100vw"
    alt="Valmis keittiö: saareke, vihreät alakaapit, valkoiset yläkaapit, kalanruotoparketti ja rimakatto."
    width={hero.attributes.width}
    height={hero.attributes.height}
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-scrim pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="wrap w-full pt-24 pb-[calc(6.75rem+env(safe-area-inset-bottom))] lg:pb-16">
    <p class="font-sans text-xs font-semibold tracking-[0.16em] text-sand uppercase">
      {company.city} · {company.region}
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl text-white sm:text-5xl lg:text-6xl">{company.slogan}</h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-white">
      Tilaa rakennus-, remontointi- ja LVI-työt Nokialta käsin. Toimimme Pirkanmaalla ja sen ympäristössä.
      Kartoituskäynti tarjousta varten on maksuton.
    </p>
    <p class="mt-5">
      <a class="hero-rating" href="#arvostelut">
        <span class="hero-stars" aria-hidden="true">★★★★★</span>
        <span>
          <span>{googleReviews.rating},0 / 5 Googlessa</span>
          <span class="hero-rating-count">{googleReviews.count} arvostelua</span>
        </span>
      </a>
    </p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn btn-primary" href="/yhteystiedot">Pyydä tarjous</a>
      <a class="btn btn-ghost-on-dark" href="/varaa">Varaa ilmainen kartoituskäynti</a>
    </div>
    <p class="mt-6">
      <a
        class="text-lg font-semibold text-white underline decoration-white/50 underline-offset-4"
        href={`tel:${company.phoneTel}`}
      >
        Soita {company.phoneDisplay}
      </a>
    </p>
    <p class="mt-2 text-sm">
      <a class="font-semibold text-white underline decoration-white/40 underline-offset-4" href={company.smsHref}>
        Tekstiviesti
      </a>
      <span aria-hidden="true"> · </span>
      <a
        class="font-semibold text-white underline decoration-white/40 underline-offset-4"
        href={company.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp<span class="sr-only"> (avautuu uuteen välilehteen)</span>
      </a>
    </p>
  </div>
</section>
