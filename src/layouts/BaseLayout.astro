---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "../styles/global.css";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import fraunces600 from "@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import JsonLd from "../components/JsonLd.astro";
import { company } from "../data/company";
import { getPalvelut } from "../lib/content";
import { localBusiness } from "../lib/jsonld";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  overlayHeader?: boolean;
}

const { title, description, noindex = false, overlayHeader = false } = Astro.props;
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;
const site = Astro.site ?? new URL(company.url);
const path = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const canonical = new URL(path, site).toString();
const ogImage = new URL("/og-image.jpg", site).toString();
const palvelut = await getPalvelut();
const business = localBusiness(
  palvelut.map((entry) => ({
    name: entry.data.title,
    description: entry.data.summary,
    url: new URL(`/palvelut/${entry.id}`, site).toString(),
  })),
);
const ogAlt = "Sivutek. Rakennus-, remontti- ja LVI-työt Nokialla ja Pirkanmaalla.";
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fi" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#1f2937" />
    <meta name="author" content={company.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fraunces600} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      company.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: company.analyticsToken })}
        />
      )
    }
    <slot name="head" />
    <JsonLd data={business} />
  </head>
  <body>
    <a class="skip-link" href="#sisalto">Siirry sisältöön</a>
    <Header overlay={overlayHeader} />
    <main id="sisalto">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
